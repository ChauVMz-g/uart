module uart #(
    parameter CLK_FREQ = 50000000,
    parameter BAUDRATE = 9600
)(
    input  wire clk_i,
    input  wire rst_i,
    input  wire rx_i,   // Chân RX vật lý
    output wire tx_o    // Chân TX vật lý
);

    // --- Các đường nối tín hiệu nội bộ ---
    wire s_tick;
    
    // Nối UART_RX -> FIFO_RX
    wire       rx_done;
    wire [7:0] rx_data;
    
    // Nối FIFO_RX -> Bridge -> FIFO_TX
    wire [7:0] fifo_rx_rdata;
    wire       fifo_rx_empty;
    wire       fifo_rx_full;
    wire       bridge_move_data;
    
    // Nối FIFO_TX -> TX_Controller & UART_TX
    wire [7:0] fifo_tx_rdata;
    wire       fifo_tx_empty;
    wire       fifo_tx_full;
    wire       fifo_tx_rd_en;
    
    // Nối TX_Controller -> UART_TX
    wire       tx_done;
    wire       uart_start;

    // Logic Cầu Nối Loopback (RX-TX Bridge)
    assign bridge_move_data = (!fifo_rx_empty) && (!fifo_tx_full);

    // 1. Khối Baud Generator
    baud_gen #(
        .CLK_FREQ(CLK_FREQ),
        .BAUDRATE(BAUDRATE)
    ) u_baud_gen (
        .clk_i   (clk_i),
        .rst_i   (rst_i),
        .s_tick_o(s_tick)
    );

    // 2. Khối UART RX
    uart_rx u_uart_rx (
        .clk_i    (clk_i),
        .rst_i    (rst_i),
        .rx_i     (rx_i),
        .s_tick_i (s_tick),
        .rx_done_o(rx_done),
        .data_o   (rx_data)
    );

    // 3. Khối FIFO RX
    fifo u_fifo_rx (
        .clk_i   (clk_i),
        .rst_i   (rst_i),
        .wr_en   (rx_done),          // Tự động nạp byte từ UART_RX
        .rd_en   (bridge_move_data), // Rút byte qua Bridge
        .w_data_i(rx_data),
        .r_data_o(fifo_rx_rdata),
        .empty_o (fifo_rx_empty),
        .full_o  (fifo_rx_full)
    );

    // 4. Khối FIFO TX
    fifo u_fifo_tx (
        .clk_i   (clk_i),
        .rst_i   (rst_i),
        .wr_en   (bridge_move_data), // Nạp byte từ Bridge
        .rd_en   (fifo_tx_rd_en),    // Rút byte theo FSM TX Controller
        .w_data_i(fifo_rx_rdata),
        .r_data_o(fifo_tx_rdata),
        .empty_o (fifo_tx_empty),
        .full_o  (fifo_tx_full)
    );

    // 5. Khối TX Controller (FSM đã viết trước đó)
    tx_controller u_tx_controller (
        .clk_i       (clk_i),
        .rst_i       (rst_i),
        .fifo_empty_i(fifo_tx_empty),
        .fifo_rd_o   (fifo_tx_rd_en),
        .tx_done_i   (tx_done),
        .uart_start_o(uart_start)
    );

    // 6. Khối UART TX
    uart_tx u_uart_tx (
        .clk_i     (clk_i),
        .rst_i     (rst_i),
        .tx_start_i(uart_start),
        .s_tick_i  (s_tick),
        .data_i    (fifo_tx_rdata),
        .tx_o      (tx_o),
        .tx_done_o (tx_done)
    );

endmodule